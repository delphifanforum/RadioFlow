<UserControl x:Class="RadioFlow.App.Controls.StationLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             Focusable="False">
  <!-- Logo yüklenemezse (veya yoksa) istasyon adının baş harfi degrade zemin üzerinde gösterilir. -->
  <Border Style="{StaticResource LogoBorder}">
    <Grid>
      <TextBlock Text="{Binding Initial, ElementName=Self}" FontSize="{Binding InitialFontSize, ElementName=Self}"
                 FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <Image Source="{Binding LogoPath, ElementName=Self, Converter={StaticResource LogoToImage}}" Stretch="UniformToFill"
             RenderOptions.BitmapScalingMode="HighQuality" />
    </Grid>
  </Border>
</UserControl>
