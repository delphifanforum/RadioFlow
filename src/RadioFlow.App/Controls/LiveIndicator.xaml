<UserControl x:Class="RadioFlow.App.Controls.LiveIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self"
             Width="12" Height="12" Focusable="False" SnapsToDevicePixels="True">
  <!--
    Canlı yayın durumu göstergesi. Dört durum, kod arkasındaki VisualStateManager.GoToState ile seçilir:
      Playing      -> mor nokta, yumuşak "nefes alma" (opacity) animasyonu, düşük CPU.
      Connecting   -> dönen mor yarım halka (bağlanıyor / arabelleğe alınıyor).
      Paused       -> sabit soluk mor nokta, animasyon yok.
      Error        -> sabit kırmızı nokta, animasyon yok.
      Stopped      -> sabit çok soluk nokta (varsayılan durum).
    Yalnızca Opacity/Angle animasyonları kullanılır (renkler hep DynamicResource ile bağlı kalır,
    böylece tema değişiminde doğru renk görünür). Animasyonlar yalnızca gerekli durumda çalışır;
    diğer durumlarda Storyboard tamamen durur, bu yüzden boştayken CPU harcanmaz.
  -->
  <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="States">
        <VisualState x:Name="Stopped">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="ErrorDot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Playing">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="ErrorDot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" RepeatBehavior="Forever">
              <LinearDoubleKeyFrame KeyTime="0:0:0" Value="1" />
              <LinearDoubleKeyFrame KeyTime="0:0:1" Value="0.45" />
              <LinearDoubleKeyFrame KeyTime="0:0:2" Value="1" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Connecting">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="ErrorDot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
            <DoubleAnimation Storyboard.TargetName="RingSpin" Storyboard.TargetProperty="Angle"
                              From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Paused">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="ErrorDot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.2" />
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Error">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
            <DoubleAnimation Storyboard.TargetName="ErrorDot" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Dönen halka: yalnızca Connecting/Buffering sırasında görünür. -->
    <Ellipse x:Name="Ring" Width="12" Height="12" Opacity="0" StrokeThickness="2"
             Stroke="{DynamicResource Brush.Accent}" StrokeDashArray="2.4 1.8" RenderTransformOrigin="0.5,0.5">
      <Ellipse.RenderTransform>
        <RotateTransform x:Name="RingSpin" Angle="0" />
      </Ellipse.RenderTransform>
    </Ellipse>

    <!-- Normal durum noktası (mor vurgu rengi). -->
    <Ellipse x:Name="Dot" Width="7" Height="7" Opacity="0.35" Fill="{DynamicResource Brush.Accent}" />

    <!-- Hata durumu noktası (kırmızı); varsayılan olarak gizli, yalnızca Error durumunda görünür. -->
    <Ellipse x:Name="ErrorDot" Width="7" Height="7" Opacity="0" Fill="{DynamicResource Brush.Danger}" />
  </Grid>
</UserControl>
