<Window x:Class="RadioFlow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RadioFlow.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="RadioFlow — Ayarlar"
        Width="580" Height="720" MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource Font.Text}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        UseLayoutRounding="True">

  <Window.Resources>
    <Style x:Key="SettingRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
  </Window.Resources>

  <Grid>
    <Border x:Name="TintLayer" Background="{DynamicResource Brush.WindowTint}" />
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <DockPanel Margin="20,0,0,0">
        <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Width="46" Height="36" FontSize="10"
                VerticalAlignment="Top" Content="&#xE8BB;" ToolTip="Kapat" Command="{Binding CancelCommand}" />
        <TextBlock Text="Ayarlar" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,4,14,8">
        <StackPanel Margin="0,0,6,0">

          <!-- Görünüm -->
          <TextBlock Style="{StaticResource Text.Section}" Text="Görünüm" Margin="0,4,0,8" />
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <ListBox DockPanel.Dock="Right" Style="{StaticResource SegmentedList}" ItemsSource="{Binding ThemeOptions}"
                       SelectedValue="{Binding SelectedTheme}" AutomationProperties.Name="Tema" />
              <TextBlock Text="Tema" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding WidgetOpacity, Converter={StaticResource Percent}}" />
                <TextBlock Text="Widget arka plan yoğunluğu" />
              </DockPanel>
              <Slider Style="{StaticResource ModernSlider}" Minimum="0.5" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                      Value="{Binding WidgetOpacity}" Margin="0,6,0,0" AutomationProperties.Name="Widget şeffaflığı" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Düşük değer, Windows 11 akrilik efektini daha görünür yapar. Efekt desteklenmeyen sistemlerde düz renk kullanılır." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <ListBox DockPanel.Dock="Right" Style="{StaticResource SegmentedList}" ItemsSource="{Binding WidgetSizeOptions}"
                       SelectedValue="{Binding WidgetSize}" AutomationProperties.Name="Widget boyutu" />
              <TextBlock Text="Widget boyutu" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Widget her zaman üstte" IsChecked="{Binding AlwaysOnTop}" />
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Kontrolleri otomatik gizle" IsChecked="{Binding AutoHideWidgetControls}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Text="Açıkken widget üzerinde yalnızca logo, isim ve oynat/duraklat görünür; önceki/sonraki, durdur, favori, ses ve genişlet düğmeleri yalnızca fare widget üzerindeyken belirir." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
                  <Run Text="{Binding MainWidth, Mode=OneWay, StringFormat={}{0:0}}" /><Run Text=" × " /><Run Text="{Binding MainHeight, Mode=OneWay, StringFormat={}{0:0}}" />
                </TextBlock>
                <TextBlock Text="Büyük pencere boyutu" />
              </DockPanel>
              <Slider Style="{StaticResource ModernSlider}" Minimum="860" Maximum="1920" TickFrequency="10" IsSnapToTickEnabled="True"
                      Value="{Binding MainWidth}" Margin="0,6,0,0" AutomationProperties.Name="Pencere genişliği" />
              <Slider Style="{StaticResource ModernSlider}" Minimum="560" Maximum="1200" TickFrequency="10" IsSnapToTickEnabled="True"
                      Value="{Binding MainHeight}" Margin="0,4,0,0" AutomationProperties.Name="Pencere yüksekliği" />
            </StackPanel>
          </Border>

          <!-- Başlangıç -->
          <TextBlock Style="{StaticResource Text.Section}" Text="Başlangıç" />
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Windows başlangıcında çalıştır"
                        IsChecked="{Binding RunAtStartup}" IsEnabled="{Binding IsStartupSupported}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding StartupNote}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Açılışta mini widget'ı göster" IsChecked="{Binding ShowWidgetOnStartup}" />
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Açılışta son radyoyu otomatik oynat" IsChecked="{Binding AutoPlayLastStation}" />
          </Border>

          <!-- Ses ve bağlantı -->
          <TextBlock Style="{StaticResource Text.Section}" Text="Ses ve bağlantı" />
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding DefaultVolume}" />
                <TextBlock Text="Açılış ses seviyesi" />
              </DockPanel>
              <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding DefaultVolume}" Margin="0,6,0,0" AutomationProperties.Name="Varsayılan ses seviyesi" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding MaxReconnectAttempts}" />
                <TextBlock Text="Bağlantı koptuğunda en fazla yeniden deneme" />
              </DockPanel>
              <Slider Style="{StaticResource ModernSlider}" Minimum="0" Maximum="20" IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding MaxReconnectAttempts}" Margin="0,6,0,0" AutomationProperties.Name="Yeniden deneme sayısı" />
              <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}">
                  <Run Text="{Binding InitialReconnectDelaySeconds, Mode=OneWay}" /><Run Text=" sn" />
                </TextBlock>
                <TextBlock Text="İlk deneme gecikmesi (her denemede iki katına çıkar, en fazla 30 sn)" TextWrapping="Wrap" />
              </DockPanel>
              <Slider Style="{StaticResource ModernSlider}" Minimum="1" Maximum="30" IsSnapToTickEnabled="True" TickFrequency="1"
                      Value="{Binding InitialReconnectDelaySeconds}" Margin="0,6,0,0" AutomationProperties.Name="Yeniden deneme gecikmesi" />
            </StackPanel>
          </Border>

          <!-- Sistem -->
          <TextBlock Style="{StaticResource Text.Section}" Text="Sistem tepsisi ve bildirimler" />
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <CheckBox Style="{StaticResource ToggleSwitch}" Content="Widget kapatıldığında sistem tepsisine küçült" IsChecked="{Binding MinimizeToTray}" />
              <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                         Text="Kapalıysa widget'ı kapatmak (büyük pencere de kapalıyken) uygulamadan çıkar." />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Bildirimleri göster (istasyon değişimi, bağlantı hatası)" IsChecked="{Binding ShowNotifications}" />
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <CheckBox Style="{StaticResource ToggleSwitch}" Content="Şarkı değiştiğinde bildir (yayın şarkı bilgisi gönderiyorsa)"
                      IsChecked="{Binding NotifyOnSongChange}" IsEnabled="{Binding ShowNotifications}" />
          </Border>

          <!-- Dil ve katalog -->
          <TextBlock Style="{StaticResource Text.Section}" Text="Dil ve katalog" />
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <ListBox DockPanel.Dock="Right" Style="{StaticResource SegmentedList}" ItemsSource="{Binding LanguageOptions}"
                       SelectedValue="{Binding Language}" AutomationProperties.Name="Dil" />
              <TextBlock Text="Arayüz dili" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border Style="{StaticResource SettingRow}">
            <DockPanel>
              <TextBox DockPanel.Dock="Right" Style="{StaticResource InputBox}" Width="70" MaxLength="2" Tag="TR"
                       CharacterCasing="Upper" Text="{Binding DefaultCountryCode, UpdateSourceTrigger=PropertyChanged}" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ana sayfa ülkesi (ISO kodu)" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="Ör. TR, DE, GB, US" />
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Veri -->
          <TextBlock Style="{StaticResource Text.Section}" Text="Veri" />
          <Border Style="{StaticResource SettingRow}">
            <StackPanel>
              <TextBlock Text="Favoriler, geçmiş, ayarlar ve loglar bu klasörde saklanır:" TextWrapping="Wrap" />
              <TextBox Style="{StaticResource InputBox}" Margin="0,6,0,0" IsReadOnly="True" Text="{Binding DataDirectory, Mode=OneWay}" />
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Klasörü aç" Command="{Binding OpenDataFolderCommand}" />
                <Button Style="{StaticResource SecondaryButton}" Content="Logları aç" Margin="8,0,0,0" Command="{Binding OpenLogsFolderCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="2,12,0,8"
                     Text="{DynamicResource Str.ThirdPartyNotice}" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.SurfaceStroke}" BorderThickness="0,1,0,0" Padding="20,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Str.Cancel}" Command="{Binding CancelCommand}" />
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Str.Save}" Margin="8,0,0,0" Command="{Binding SaveCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                     VerticalAlignment="Center" Margin="0,0,12,0"
                     Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}" />
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
