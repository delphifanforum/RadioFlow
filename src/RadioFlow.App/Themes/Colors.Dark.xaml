<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Koyu tema (varsayılan) -->
  <Color x:Key="Color.Accent">#FF8B7CF6</Color>
  <Color x:Key="Color.Accent2">#FFD066E8</Color>

  <SolidColorBrush x:Key="Brush.WindowTint" Color="#FF16151D" />
  <SolidColorBrush x:Key="Brush.SolidBackground" Color="#FF16151D" />
  <SolidColorBrush x:Key="Brush.Pane" Color="#33000000" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#22FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#10FFFFFF" />
  <SolidColorBrush x:Key="Brush.SurfaceStroke" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="Brush.Card" Color="#18FFFFFF" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#26FFFFFF" />
  <SolidColorBrush x:Key="Brush.Popup" Color="#FF24232C" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#99000000" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF5F5F7" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#C8FFFFFF" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="#80FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFA195FA" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF7466E0" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#338B7CF6" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Favorite" Color="#FFFFC857" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FFFF6B6B" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFB547" />
  <SolidColorBrush x:Key="Brush.Track" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="Brush.InputBackground" Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="Brush.InputBackgroundFocused" Color="#FF1E1D26" />

  <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource Color.Accent}" />
    <GradientStop Offset="1" Color="{StaticResource Color.Accent2}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.LogoPlaceholder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FF4F46E5" />
    <GradientStop Offset="1" Color="#FFC026D3" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#FF000000</Color>
</ResourceDictionary>
