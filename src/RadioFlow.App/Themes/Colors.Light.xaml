<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Açık tema -->
  <Color x:Key="Color.Accent">#FF6D5DF0</Color>
  <Color x:Key="Color.Accent2">#FFB43FD0</Color>

  <SolidColorBrush x:Key="Brush.WindowTint" Color="#FFF6F5FA" />
  <SolidColorBrush x:Key="Brush.SolidBackground" Color="#FFF3F2F8" />
  <SolidColorBrush x:Key="Brush.Pane" Color="#0D000000" />
  <SolidColorBrush x:Key="Brush.Surface" Color="#0F000000" />
  <SolidColorBrush x:Key="Brush.SurfaceHover" Color="#1A000000" />
  <SolidColorBrush x:Key="Brush.SurfacePressed" Color="#0A000000" />
  <SolidColorBrush x:Key="Brush.SurfaceStroke" Color="#1A000000" />
  <SolidColorBrush x:Key="Brush.Card" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Popup" Color="#FFFBFBFE" />
  <SolidColorBrush x:Key="Brush.Overlay" Color="#66000000" />
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF1B1A22" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#CC1B1A22" />
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="#801B1A22" />
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF7F71F3" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF5A4AD6" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#226D5DF0" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
  <SolidColorBrush x:Key="Brush.Favorite" Color="#FFE0A100" />
  <SolidColorBrush x:Key="Brush.Danger" Color="#FFD93636" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#FFB86E00" />
  <SolidColorBrush x:Key="Brush.Track" Color="#26000000" />
  <SolidColorBrush x:Key="Brush.InputBackground" Color="#B3FFFFFF" />
  <SolidColorBrush x:Key="Brush.InputBackgroundFocused" Color="#FFFFFFFF" />

  <LinearGradientBrush x:Key="Brush.AccentGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="{StaticResource Color.Accent}" />
    <GradientStop Offset="1" Color="{StaticResource Color.Accent2}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Brush.LogoPlaceholder" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#FF6366F1" />
    <GradientStop Offset="1" Color="#FFD946EF" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#FF6B6880</Color>
</ResourceDictionary>
